{
  "name": "reify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "demo": "npm run dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.cjs",
    "launch": "node scripts/launch.cjs",
    "doctor": "node scripts/doctor.cjs",
    "check:secrets": "node scripts/check-secrets.cjs",
    "check:gemma": "node --env-file-if-exists=.env.local scripts/check-gemma.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "twinly:verify": "node scripts/verify-twinly.cjs",
    "test:twinly-mock": "node scripts/test-twinly-mock.cjs"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@xyflow/react": "^12.9.0",
    "lucide-react": "latest",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24 <25"
  }
